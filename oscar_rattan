        function filterCategory(catName) {
            activeCategoryFilter = catName;
            document.getElementById('active-category-filter-label').innerText = catName === 'ALL' ? 'عرض جميع المنتجات' : `قسم: ${catName}`;
            renderCategoriesGrid();
            renderProductsGrid();
            scrollToSection('catalog-section');
        }

        function handleSearch(query) {
            const q = query.toLowerCase().trim();
            const container = document.getElementById('products-grid-container');
            const filtered = appState.products.filter(p => p.visible && (p.title.toLowerCase().includes(q) || p.description.toLowerCase().includes(q)));
            
            container.innerHTML = filtered.map(product => `
                <div class="product-card bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden flex flex-col justify-between">
                    <div class="p-4 space-y-2">
                        <h4 class="text-sm font-bold text-white">${product.title}</h4>
                        <span class="text-base font-extrabold gold-gradient-text">${product.price.toLocaleString()} ج.م</span>
                    </div>
                    <div class="p-4 pt-0">
                        <button onclick="openCustomizerModal('${product.id}')" class="w-full amber-gradient text-black font-bold py-2 rounded-xl text-xs">تخصيص الطلب</button>
                    </div>
                </div>
            `).join('');
        }

        /* ==========================================================================
           PRODUCT CUSTOMIZER & SUNBRELLA CALCULATOR
           ========================================================================== */
        let activeCustomizerProduct = null;
        let selectedUpholsteryId = null;
        let selectedCushionColor = null;
        let selectedWickerColor = null;
        let sunbrellaChecked = false;
        let customizerQty = 1;

        function openCustomizerModal(productId) {
            const product = appState.products.find(p => p.id === productId);
            if (!product) return;

            activeCustomizerProduct = product;
            selectedUpholsteryId = appState.upholsteryTypes[0]?.id || null;
            selectedCushionColor = appState.cushionColors[0]?.name || '';
            selectedWickerColor = appState.wickerColors[0]?.name || '';
            sunbrellaChecked = false;
            customizerQty = 1;

            renderCustomizerModalContent();
            document.getElementById('product-detail-modal').classList.remove('hidden');
        }

        function renderCustomizerModalContent() {
            const p = activeCustomizerProduct;
            const container = document.getElementById('modal-product-content');

            // Calculate extra costs
            const selectedUph = appState.upholsteryTypes.find(u => u.id === selectedUpholsteryId);
            const uphExtraFee = (selectedUph?.extraFeePerUnit || 0) * (p.isChairProduct ? (p.chairCount || 1) : 1);
            
            // Sunbrella surcharge calculation
            const chairsPerSet = p.isChairProduct ? (p.chairCount || 1) : 0;
            const sunbrellaCostPerUnit = sunbrellaChecked ? (chairsPerSet * appState.sunbrellaRatePerChair) : 0;

            const unitTotalPrice = p.price + uphExtraFee + sunbrellaCostPerUnit;
            const grandTotal = unitTotalPrice * customizerQty;

            container.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Image Preview -->
                    <div>
                        <div class="rounded-2xl overflow-hidden border border-neutral-800 bg-black h-64 md:h-80">
                            <img src="${p.images[0]}" alt="${p.title}" class="w-full h-full object-cover">
                        </div>
                    </div>

                    <!-- Customization Options -->
                    <div class="space-y-4">
                        <div>
                            <span class="wine-gradient text-white text-[10px] font-bold px-2 py-0.5 rounded">${p.category}</span>
                            <h3 class="text-lg font-black text-white mt-1">${p.title}</h3>
                            <p class="text-xs text-gray-400 mt-1">${p.description}</p>
                        </div>

                        <!-- Upholstery Selection -->
                        <div>
                            <label class="block text-xs font-bold text-gray-300 mb-1.5">نوع قماش التنجيد:</label>
                            <div class="space-y-1.5">
                                ${appState.upholsteryTypes.map(uph => `
                                    <label onclick="selectUpholstery('${uph.id}')" class="flex items-center justify-between p-2.5 rounded-xl border text-xs cursor-pointer ${selectedUpholsteryId === uph.id ? 'border-brand-amber bg-neutral-800 text-white font-bold' : 'border-neutral-800 bg-black text-gray-400'}">
                                        <span>${uph.name}</span>
                                        <span class="text-brand-amber font-bold">${uph.extraFeePerUnit > 0 ? `+${uph.extraFeePerUnit} ج.م` : 'أساسي'}</span>
                                    </label>
                                `).join('')}
                            </div>
                        </div>

                        <!-- Cushion Color Picker -->
                        <div>
                            <label class="block text-xs font-bold text-gray-300 mb-1.5">لون التنجيد (Cushion Color): <span class="text-brand-amber font-bold">${selectedCushionColor}</span></label>
                            <div class="flex flex-wrap gap-2">
                                ${appState.cushionColors.map(c => `
                                    <button onclick="selectCushionColor('${c.name}')" title="${c.name}" class="w-7 h-7 rounded-full border border-white/20 transition transform hover:scale-110 ${selectedCushionColor === c.name ? 'ring-2 ring-brand-amber scale-110' : ''}" style="background-color: ${c.hex}"></button>
                                `).join('')}
                            </div>
                        </div>

                        <!-- Wicker Color Picker -->
                        <div>
                            <label class="block text-xs font-bold text-gray-300 mb-1.5">لون مشدود الرتان: <span class="text-brand-amber font-bold">${selectedWickerColor}</span></label>
                            <div class="flex flex-wrap gap-2">
                                ${appState.wickerColors.map(w => `
                                    <button onclick="selectWickerColor('${w.name}')" title="${w.name}" class="w-7 h-7 rounded-full border border-white/20 transition transform hover:scale-110 ${selectedWickerColor === w.name ? 'ring-2 ring-brand-amber scale-110' : ''}" style="background-color: ${w.hex}"></button>
                                `).join('')}
                            </div>
                        </div>

                        <!-- Sunbrella Toggle Option -->
                        ${p.isChairProduct ? `
                            <div class="border border-brand-amber/40 bg-neutral-950 p-3 rounded-2xl flex items-center justify-between">
                                <div>
                                    <h5 class="text-xs font-bold text-white flex items-center"><i class="fas fa-sun text-yellow-500 ml-1.5"></i> خيار أقمشة Sunbrella العالمية</h5>
                                    <p class="text-[10px] text-gray-400">حساب تلقائي: ${chairsPerSet} كراسي × ${appState.sunbrellaRatePerChair} ج.م = <span class="text-brand-amber font-bold">+${chairsPerSet * appState.sunbrellaRatePerChair} ج.م</span></p>
                                </div>
                                <input type="checkbox" onchange="toggleSunbrella(this.checked)" ${sunbrellaChecked ? 'checked' : ''} class="w-5 h-5 accent-brand-amber cursor-pointer">
                            </div>
                        ` : ''}

                        <!-- Quantity Selector -->
                        <div class="flex items-center justify-between border-t border-neutral-800 pt-3">
                            <span class="text-xs font-bold text-gray-300">الكمية المطلوبة:</span>
                            <div class="flex items-center space-x-3 space-x-reverse bg-black border border-neutral-700 rounded-xl px-3 py-1">
                                <button onclick="changeCustomizerQty(-1)" class="text-gray-400 hover:text-white font-bold text-base">-</button>
                                <span class="text-white font-bold text-sm px-2">${customizerQty}</span>
                                <button onclick="changeCustomizerQty(1)" class="text-gray-400 hover:text-white font-bold text-base">+</button>
                            </div>
                        </div>

                        <!-- Price Breakdown & Add to Cart -->
                        <div class="bg-black p-4 rounded-2xl border border-neutral-800 space-y-2">
                            <div class="flex justify-between text-xs text-gray-400">
                                <span>سعر الوحدة الإجمالي:</span>
                                <span>${unitTotalPrice.toLocaleString()} ج.م</span>
                            </div>
                            <div class="flex justify-between text-sm font-black text-white border-t border-neutral-800 pt-2">
                                <span>الإجمالي النهائي:</span>
                                <span class="gold-gradient-text font-extrabold text-base">${grandTotal.toLocaleString()} ج.م</span>
                            </div>
                            <button onclick="confirmAddToCart()" class="w-full wine-gradient hover:opacity-90 text-white font-extrabold py-3 rounded-xl border border-brand-amber/30 transition shadow-lg text-xs mt-2">
                                إضافة إلى سلة الطلبات <i class="fas fa-cart-plus mr-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function selectUpholstery(uphId) { selectedUpholsteryId = uphId; renderCustomizerModalContent(); }
        function selectCushionColor(colorName) { selectedCushionColor = colorName; renderCustomizerModalContent(); }
        function selectWickerColor(colorName) { selectedWickerColor = colorName; renderCustomizerModalContent(); }
        function toggleSunbrella(checked) { sunbrellaChecked = checked; renderCustomizerModalContent(); }
        function changeCustomizerQty(delta) { customizerQty = Math.max(1, customizerQty + delta); renderCustomizerModalContent(); }
        function closeProductModal() { document.getElementById('product-detail-modal').classList.add('hidden'); }

        function confirmAddToCart() {
            const p = activeCustomizerProduct;
            const selectedUph = appState.upholsteryTypes.find(u => u.id === selectedUpholsteryId);
            const chairsPerSet = p.isChairProduct ? (p.chairCount || 1) : 0;
            const sunbrellaCost = sunbrellaChecked ? (chairsPerSet * appState.sunbrellaRatePerChair) : 0;
            const unitPrice = p.price + (selectedUph?.extraFeePerUnit || 0) + sunbrellaCost;

            const cartItem = {
                cartItemId: "item-" + Date.now(),
                productId: p.id,
                productTitle: p.title,
                image: p.images[0],
                qty: customizerQty,
                unitPrice: unitPrice,
                upholsteryName: selectedUph?.name || 'أساسي',
                cushionColor: selectedCushionColor,
                wickerColor: selectedWickerColor,
                sunbrellaAdded: sunbrellaChecked,
                sunbrellaCost: sunbrellaCost * customizerQty
            };

            currentCart.push(cartItem);
            closeProductModal();
            updateCartBadge();
            renderCartDrawer();
            toggleCartDrawer(true);
        }

        function toggleCartDrawer(open) {
            const drawer = document.getElementById('cart-drawer');
            const overlay = document.getElementById('cart-drawer-overlay');
            if (open) {
                renderCartDrawer();
                overlay.classList.remove('hidden');
                drawer.classList.remove('-translate-x-full');
            } else {
                overlay.classList.add('hidden');
                drawer.classList.add('-translate-x-full');
            }
        }

        function renderCartDrawer() {
            const container = document.getElementById('cart-drawer-items');
            if (!container) return;

            if (currentCart.length === 0) {
                container.innerHTML = `<div class="py-12 text-center text-gray-500 text-xs">سلة الشراء فارغة حالياً</div>`;
                document.getElementById('cart-subtotal-text').innerText = "0 ج.م";
                document.getElementById('cart-discount-text').innerText = "0 ج.م";
                document.getElementById('cart-total-text').innerText = "0 ج.م";
                return;
            }

            let subtotal = 0;
            container.innerHTML = currentCart.map((item, index) => {
                const itemTotal = item.unitPrice * item.qty;
                subtotal += itemTotal;
                return `
                    <div class="bg-black p-3 rounded-2xl border border-neutral-800 flex gap-3 text-xs relative">
                        <img src="${item.image}" class="w-16 h-16 rounded-xl object-cover">
                        <div class="flex-grow space-y-1">
                            <h5 class="font-bold text-white line-clamp-1">${item.productTitle}</h5>
                            <p class="text-[10px] text-gray-400">التنجيد: ${item.upholsteryName} | القماش: ${item.cushionColor}</p>
                            <p class="text-[10px] text-gray-400">الرتان: ${item.wickerColor} ${item.sunbrellaAdded ? ' | <span class="text-yellow-500 font-bold">Sunbrella</span>' : ''}</p>
                            <div class="flex justify-between items-center pt-1">
                                <span class="font-bold text-brand-amber">${itemTotal.toLocaleString()} ج.م</span>
                                <div class="flex items-center space-x-2 space-x-reverse">
                                    <button onclick="updateCartQty(${index}, -1)" class="w-5 h-5 bg-neutral-800 rounded text-gray-300">-</button>
                                    <span class="text-white font-bold">${item.qty}</span>
                                    <button onclick="updateCartQty(${index}, 1)" class="w-5 h-5 bg-neutral-800 rounded text-gray-300">+</button>
                                </div>
                            </div>
                        </div>
                        <button onclick="removeCartItem(${index})" class="text-red-500 hover:text-red-400 text-xs p-1">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                `;
            }).join('');

            // Volume Discount rule
            let discount = 0;
            const totalQty = currentCart.reduce((sum, i) => sum + i.qty, 0);
            if (totalQty >= 10) discount = subtotal * 0.10; // 10% off for 10+ items

            document.getElementById('cart-subtotal-text').innerText = `${subtotal.toLocaleString()} ج.م`;
            document.getElementById('cart-discount-text').innerText = `${discount.toLocaleString()} ج.م`;
            document.getElementById('cart-total-text').innerText = `${(subtotal - discount).toLocaleString()} ج.م`;
        }

        function updateCartQty(index, delta) {
            currentCart[index].qty += delta;
            if (currentCart[index].qty <= 0) currentCart.splice(index, 1);
            updateCartBadge();
            renderCartDrawer();
        }

        function removeCartItem(index) {
            currentCart.splice(index, 1);
            updateCartBadge();
            renderCartDrawer();
        }

        function updateCartBadge() {
            const count = currentCart.reduce((sum, i) => sum + i.qty, 0);
            document.getElementById('cart-badge-count').innerText = count;
        }

        /* ==========================================================================
           CHECKOUT & ORDER SUBMISSION
           ========================================================================== */
        function openCheckoutModal() {
            if (currentCart.length === 0) {
                alert("سلة الشراء فارغة، قم بإضافة منتجات أولاً.");
                return;
            }

            // Render shipping radios
            const shippingContainer = document.getElementById('checkout-shipping-options');
            shippingContainer.innerHTML = appState.shippingOptions.map((opt, idx) => `
                <label class="flex items-center justify-between p-3 rounded-xl border border-neutral-700 bg-black cursor-pointer hover:border-brand-amber">
                    <div class="flex items-center space-x-2 space-x-reverse">
                        <input type="radio" name="ship_option" value="${opt.id}" ${idx === 0 ? 'checked' : ''}>
                        <div>
                            <span class="text-xs font-bold text-white">${opt.name}</span>
                            <p class="text-[10px] text-gray-400">${opt.timeframe}</p>
                        </div>
                    </div>
                    <span class="text-xs font-bold text-brand-amber">${opt.price === 0 ? 'مجاناً' : `${opt.price} ج.م`}</span>
                </label>
            `).join('');

            toggleCartDrawer(false);
            document.getElementById('checkout-modal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkout-modal').classList.add('hidden');
        }

        function handlePlaceOrder(e) {
            e.preventDefault();

            const name = document.getElementById('chk-name').value;
            const phone = document.getElementById('chk-phone').value;
            const whatsapp = document.getElementById('chk-whatsapp').value || phone;
            const gov = document.getElementById('chk-gov').value;
            const city = document.getElementById('chk-city').value;
            const address = document.getElementById('chk-address').value;
            const location = document.getElementById('chk-location').value;

            const shipVal = document.querySelector('input[name="ship_option"]:checked')?.value;
            const selectedShip = appState.shippingOptions.find(s => s.id === shipVal) || appState.shippingOptions[0];

            const payVal = document.querySelector('input[name="pay_method"]:checked')?.value || 'card';

            const subtotal = currentCart.reduce((sum, item) => sum + (item.unitPrice * item.qty), 0);
            const discount = currentCart.reduce((sum, i) => sum + i.qty, 0) >= 10 ? subtotal * 0.10 : 0;
            const total = subtotal - discount + selectedShip.price;

            const newOrder = {
                id: "ORD-" + Math.floor(10000 + Math.random() * 90000),
                date: new Date().toISOString().split('T')[0],
                customer: { name, phone, whatsapp, gov, city, address, location },
                items: currentCart,
                subtotal: subtotal,
                shippingCost: selectedShip.price,
                discount: discount,
                total: total,
                shippingMethod: selectedShip.name,
                paymentMethod: payVal === 'card' ? 'بطاقة فيزا / ماستر (Paymob)' : (payVal === 'vodafone' ? 'فودافون كاش' : 'انستا باي InstaPay'),
                status: "New"
            };

            appState.orders.unshift(newOrder);
            saveState();

            currentCart = [];
            updateCartBadge();
            closeCheckoutModal();

            alert(`تم تسجيل طلبك بنجاح! 🎉\nرقم الطلب الخاص بك: ${newOrder.id}\nسيقوم فريق المصنع بالتواصل معكم قريباً.`);
            switchView('orders-track');
            document.getElementById('track-order-id-input').value = newOrder.id;
            trackOrderSubmit();
        }

        function trackOrderSubmit() {
            const orderId = document.getElementById('track-order-id-input').value.trim();
            const container = document.getElementById('track-result-container');
            const order = appState.orders.find(o => o.id.toLowerCase() === orderId.toLowerCase());

            container.classList.remove('hidden');
            if (!order) {
                container.innerHTML = `<p class="text-red-400 text-center text-xs font-bold">لم يتم العثور على طلب بهذا الرقم. يرجى التأكد وإعادة المحاولة.</p>`;
                return;
            }

            container.innerHTML = `
                <div class="bg-black p-4 rounded-2xl border border-neutral-800 space-y-3 text-xs">
                    <div class="flex justify-between items-center border-b border-neutral-800 pb-2">
                        <span class="font-bold text-white">رقم الطلب: ${order.id}</span>
                        <span class="wine-gradient text-white text-[10px] px-2.5 py-0.5 rounded-full font-bold">حالة الطلب: ${order.status}</span>
                    </div>
                    <p class="text-gray-300">اسم العميل: <span class="text-white font-bold">${order.customer.name}</span> (${order.customer.phone})</p>
                    <p class="text-gray-300">العنوان: ${order.customer.gov} - ${order.customer.city} - ${order.customer.address}</p>
                    <p class="text-gray-300">طريقة الدفع: ${order.paymentMethod}</p>
                    <div class="border-t border-neutral-800 pt-2 flex justify-between font-bold text-sm text-brand-amber">
                        <span>إجمالي المبلّغ المطلوب:</span>
                        <span>${order.total.toLocaleString()} ج.م</span>
                    </div>
                </div>
            `;
        }

        /* ==========================================================================
           ADMIN AUTHENTICATION & SECURITY
           ========================================================================== */
        function handleAdminLogin(e) {
            e.preventDefault();
            const user = document.getElementById('admin-user-input').value;
            const pass = document.getElementById('admin-pass-input').value;

            if (user === appState.adminAuth.username && pass === appState.adminAuth.passwordHash) {
                sessionStorage.setItem('OSCAR_ADMIN_AUTH', 'true');
                document.getElementById('current-admin-display-name').innerText = user;
                switchView('admin-dashboard');
            } else {
                alert("خطأ في اسم المستخدم أو كلمة المرور الإدارية.");
            }
        }

        function handleAdminLogout() {
            sessionStorage.removeItem('OSCAR_ADMIN_AUTH');
            switchView('store');
        }

        function saveAdminSecurityCredentials(e) {
            e.preventDefault();
            const newUser = document.getElementById('sec-username-input').value.trim();
            const newPass = document.getElementById('sec-password-input').value;
            const confirmPass = document.getElementById('sec-confirm-password-input').value;

            if (newPass !== confirmPass) {
                alert("كلمتا المرور غير متطابقتين.");
                return;
            }

            appState.adminAuth.username = newUser;
            appState.adminAuth.passwordHash = newPass;
            saveState();

            alert("تم تحديث اسم المستخدم وكلمة المرور الإدارية بنجاح!");
            document.getElementById('sec-username-input').value = "";
            document.getElementById('sec-password-input').value = "";
            document.getElementById('sec-confirm-password-input').value = "";
        }

        /* ==========================================================================
           ADMIN DASHBOARD CONTROLS & TABS
           ========================================================================== */
        function switchAdminTab(tabName) {
            activeAdminTab = tabName;
            ['orders', 'products', 'categories', 'customizer', 'shipping', 'site-settings', 'security'].forEach(t => {
                const el = document.getElementById(`admin-tab-${t}`);
                const btn = document.getElementById(`tab-btn-${t}`);
                if (el) el.classList.add('hidden');
                if (btn) {
                    btn.classList.remove('bg-brand-wine', 'text-white', 'border', 'border-brand-amber/30');
                    btn.classList.add('bg-neutral-900', 'text-gray-300');
                }
            });

            const activeEl = document.getElementById(`admin-tab-${tabName}`);
            const activeBtn = document.getElementById(`tab-btn-${tabName}`);
            if (activeEl) activeEl.classList.remove('hidden');
            if (activeBtn) {
                activeBtn.classList.remove('bg-neutral-900', 'text-gray-300');
                activeBtn.classList.add('bg-brand-wine', 'text-white', 'border', 'border-brand-amber/30');
            }
        }

        function renderAdminDashboard() {
            renderAdminOrders();
            renderAdminProducts();
            renderAdminCategories();
            renderAdminCustomizerSettings();
            renderAdminShippingSettings();
            populateAdminCMSSettings();
        }

        function renderAdminOrders() {
            const tbody = document.getElementById('admin-orders-table-body');
            if (!tbody) return;

            let totalRev = appState.orders.reduce((sum, o) => sum + o.total, 0);
            document.getElementById('total-revenue-display').innerText = `إجمالي المبيعات: ${totalRev.toLocaleString()} ج.م`;
            document.getElementById('admin-pending-count-badge').innerText = appState.orders.filter(o => o.status === 'New').length;

            tbody.innerHTML = appState.orders.map(order => `
                <tr class="hover:bg-neutral-950 transition">
                    <td class="p-4 font-bold text-white">${order.id}<br><span class="text-[10px] text-gray-500">${order.date}</span></td>
                    <td class="p-4">${order.customer.name}<br><span class="text-brand-amber">${order.customer.phone}</span></td>
                    <td class="p-4">${order.customer.gov} - ${order.customer.city}</td>
                    <td class="p-4 font-semibold">${order.items.map(i => `${i.productTitle} (×${i.qty})`).join(', ')}</td>
                    <td class="p-4 font-extrabold text-brand-amber">${order.total.toLocaleString()} ج.م</td>
                    <td class="p-4">${order.paymentMethod}</td>
                    <td class="p-4">
                        <select onchange="updateOrderStatus('${order.id}', this.value)" class="bg-black border border-neutral-700 rounded p-1 text-white text-xs">
                            <option value="New" ${order.status === 'New' ? 'selected' : ''}>New (جديد)</option>
                            <option value="Confirmed" ${order.status === 'Confirmed' ? 'selected' : ''}>Confirmed (مؤكد)</option>
                            <option value="Processing" ${order.status === 'Processing' ? 'selected' : ''}>Processing (جاري التصنيع)</option>
                            <option value="Shipped" ${order.status === 'Shipped' ? 'selected' : ''}>Shipped (تم الشحن)</option>
                            <option value="Delivered" ${order.status === 'Delivered' ? 'selected' : ''}>Delivered (تم التسليم)</option>
                        </select>
                    </td>
                    <td class="p-4">
                        <button onclick="deleteOrder('${order.id}')" class="text-red-500 hover:text-red-400"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function updateOrderStatus(orderId, newStatus) {
            const order = appState.orders.find(o => o.id === orderId);
            if (order) {
                order.status = newStatus;
                saveState();
            }
        }

        function deleteOrder(orderId) {
            if (confirm("هل أنت تأكد من حذف هذا الطلب نهائياً؟")) {
                appState.orders = appState.orders.filter(o => o.id !== orderId);
                saveState();
            }
        }

        function renderAdminProducts() {
            const container = document.getElementById('admin-products-list-grid');
            if (!container) return;

            container.innerHTML = appState.products.map(p => `
                <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 flex justify-between items-start text-xs">
                    <div class="space-y-1">
                        <h4 class="font-bold text-white">${p.title}</h4>
                        <p class="text-gray-400">القسم: ${p.category} | SKU: ${p.sku}</p>
                        <p class="text-brand-amber font-extrabold text-sm">${p.price.toLocaleString()} ج.م</p>
                    </div>
                    <div class="flex space-x-2 space-x-reverse">
                        <button onclick="toggleProductVisibility('${p.id}')" class="text-gray-400 hover:text-white"><i class="fas ${p.visible ? 'fa-eye' : 'fa-eye-slash'}"></i></button>
                        <button onclick="deleteProduct('${p.id}')" class="text-red-500 hover:text-red-400"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            `).join('');
        }

        function toggleProductVisibility(id) {
            const p = appState.products.find(item => item.id === id);
            if (p) { p.visible = !p.visible; saveState(); }
        }

        function deleteProduct(id) {
            if (confirm("هل تريد حذف هذا المنتج؟")) {
                appState.products = appState.products.filter(item => item.id !== id);
                saveState();
            }
        }

        function openProductModal() {
            const name = prompt("ادخل اسم المنتج الجديد:");
            if (!name) return;
            const price = parseFloat(prompt("ادخل سعر المنتج (بالجنيه):", "1000")) || 1000;
            const category = appState.categories[0]?.name || "أثاث الكافيهات";

            const newProd = {
                id: "prod-" + Date.now(),
                title: name,
                category: category,
                price: price,
                oldPrice: price + 200,
                sku: "OSC-" + Math.floor(100 + Math.random() * 900),
                images: ["https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=600&q=80"],
                description: "منتج جديد مصنع من الرتان عالي الجودة والألومنيوم المعالج.",
                isChairProduct: true,
                chairCount: 1,
                featured: false,
                visible: true
            };

            appState.products.unshift(newProd);
            saveState();
        }

        function renderAdminCategories() {
            const container = document.getElementById('admin-categories-manage-grid');
            if (!container) return;

            container.innerHTML = appState.categories.map(cat => `
                <div class="bg-black border border-neutral-800 p-3 rounded-xl flex items-center justify-between text-xs">
                    <span class="font-bold text-white">${cat.name}</span>
                    <div class="flex items-center space-x-2 space-x-reverse">
                        <button onclick="toggleCategoryVisibility('${cat.id}')" class="text-gray-400 hover:text-white"><i class="fas ${cat.visible ? 'fa-eye' : 'fa-eye-slash'}"></i></button>
                        <button onclick="deleteCategory('${cat.id}')" class="text-red-500 hover:text-red-400"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            `).join('');
        }

        function openCategoryModal() {
            const name = prompt("ادخل اسم القسم الجديد:");
            if (!name) return;
            appState.categories.push({
                id: "cat-" + Date.now(),
                name: name,
                image: "https://images.unsplash.com/photo-1540555700478-4be289fbecef?auto=format&fit=crop&w=400&q=80",
                visible: true,
                order: appState.categories.length + 1
            });
            saveState();
        }

        function toggleCategoryVisibility(id) {
            const c = appState.categories.find(item => item.id === id);
            if (c) { c.visible = !c.visible; saveState(); }
        }

        function deleteCategory(id) {
            appState.categories = appState.categories.filter(item => item.id !== id);
            saveState();
        }

        function renderAdminCustomizerSettings() {
            document.getElementById('current-sunbrella-rate-tag').innerText = `${appState.sunbrellaRatePerChair} ج.م / كرسي`;
            document.getElementById('sunbrella-rate-input').value = appState.sunbrellaRatePerChair;

            // Render Upholstery Types
            const uphList = document.getElementById('admin-upholstery-types-list');
            if (uphList) {
                uphList.innerHTML = appState.upholsteryTypes.map(u => `
                    <div class="bg-black border border-neutral-800 p-3 rounded-xl flex justify-between items-center text-xs">
                        <span class="font-bold text-white">${u.name}</span>
                        <span class="text-brand-amber font-bold">+${u.extraFeePerUnit} ج.م</span>
                    </div>
                `).join('');
            }

            // Render Color Dots
            const cushionContainer = document.getElementById('admin-cushion-colors-dots');
            if (cushionContainer) {
                cushionContainer.innerHTML = appState.cushionColors.map(c => `
                    <span class="inline-flex items-center gap-1 bg-black border border-neutral-800 px-2.5 py-1 rounded-full text-[10px] text-gray-300">
                        <span class="w-3 h-3 rounded-full" style="background-color: ${c.hex}"></span>
                        ${c.name}
                    </span>
                `).join('');
            }

            const wickerContainer = document.getElementById('admin-wicker-colors-dots');
            if (wickerContainer) {
                wickerContainer.innerHTML = appState.wickerColors.map(w => `
                    <span class="inline-flex items-center gap-1 bg-black border border-neutral-800 px-2.5 py-1 rounded-full text-[10px] text-gray-300">
                        <span class="w-3 h-3 rounded-full" style="background-color: ${w.hex}"></span>
                        ${w.name}
                    </span>
                `).join('');
            }
        }

        function saveSunbrellaRate() {
            const val = parseFloat(document.getElementById('sunbrella-rate-input').value) || 200;
            appState.sunbrellaRatePerChair = val;
            saveState();
            alert("تم حفظ سعر Sunbrella الجديد بنجاح!");
        }

        function addUpholsteryTypePrompt() {
            const name = prompt("ادخل اسم نوع التنجيد الجديد:");
            if (!name) return;
            const fee = parseFloat(prompt("السعر الإضافي لكل وحدة (0 إذا كان أساسي):", "0")) || 0;
            appState.upholsteryTypes.push({ id: "uph-" + Date.now(), name, extraFeePerUnit: fee });
            saveState();
        }

        function addColorPrompt(type) {
            const name = prompt("اسم اللون الجديد:");
            if (!name) return;
            const hex = prompt("كود اللون HEX (مثال: #FF0000):", "#808080") || "#808080";

            if (type === 'cushion') appState.cushionColors.push({ name, hex });
            else appState.wickerColors.push({ name, hex });
            saveState();
        }

        function renderAdminShippingSettings() {
            const list = document.getElementById('admin-shipping-options-list');
            if (!list) return;

            list.innerHTML = appState.shippingOptions.map(opt => `
                <div class="bg-black border border-neutral-800 p-3 rounded-xl flex justify-between items-center text-xs">
                    <div>
                        <span class="font-bold text-white">${opt.name}</span>
                        <p class="text-[10px] text-gray-400">${opt.timeframe}</p>
                    </div>
                    <span class="text-brand-amber font-extrabold">${opt.price === 0 ? 'مجاناً' : `${opt.price} ج.م`}</span>
                </div>
            `).join('');
        }

        function addShippingOptionPrompt() {
            const name = prompt("اسم مدة الشحن الخيار:");
            if (!name) return;
            const price = parseFloat(prompt("التكلفة (0 للمجاني):", "100")) || 0;
            const timeframe = prompt("المدة الزمنية للتسليم:", "من 2 إلى 4 أيام") || "غير محدد";

            appState.shippingOptions.push({ id: "ship-" + Date.now(), name, price, timeframe });
            saveState();
        }

        function populateAdminCMSSettings() {
            const s = appState.siteSettings;
            document.getElementById('setting-site-title').value = s.title;
            document.getElementById('setting-phone').value = s.phone;
            document.getElementById('setting-whatsapp').value = s.whatsapp;
            document.getElementById('setting-logo-url').value = s.logoUrl;
            document.getElementById('setting-hero-title').value = s.heroTitle;
            document.getElementById('setting-hero-subtitle').value = s.heroSubtitle;
            document.getElementById('setting-factory-address').value = s.factoryAddress;
        }

        function saveSiteSettings(e) {
            e.preventDefault();
            const s = appState.siteSettings;
            s.title = document.getElementById('setting-site-title').value;
            s.phone = document.getElementById('setting-phone').value;
            s.whatsapp = document.getElementById('setting-whatsapp').value;
            s.logoUrl = document.getElementById('setting-logo-url').value;
            s.heroTitle = document.getElementById('setting-hero-title').value;
            s.heroSubtitle = document.getElementById('setting-hero-subtitle').value;
            s.factoryAddress = document.getElementById('setting-factory-address').value;

            saveState();
            alert("تم حفظ نصوص وهوية الموقع بنجاح!");
        }

        /* ==========================================================================
           STORE-AWARE AI ASSISTANT WIDGET
           ========================================================================== */
        function toggleAIChatModal(open) {
            const modal = document.getElementById('ai-chat-modal');
            if (open) modal.classList.remove('hidden');
            else modal.classList.add('hidden');
        }

        function sendAIMessage() {
            const input = document.getElementById('ai-user-input');
            const msg = input.value.trim();
            if (!msg) return;

            const box = document.getElementById('ai-messages-box');
            
            // Add user message
            box.innerHTML += `
                <div class="bg-brand-wine p-3 rounded-2xl rounded-tl-none text-white max-w-[85%] mr-auto font-bold">
                    ${msg}
                </div>
            `;
            input.value = "";
            box.scrollTop = box.scrollHeight;

            // Generate AI store-based response
            setTimeout(() => {
                let aiReply = "أهلاً بك! يمكنني مساعدتك في استفسارات منتجات أوسكار رتان، أقمشة Sunbrella، أو توصيل طلبات الكافيهات للمحافظات.";
                const lowerMsg = msg.toLowerCase();

                if (lowerMsg.includes('سعر') || lowerMsg.includes('أسعار') || lowerMsg.includes('بكام')) {
                    const sample = appState.products[0];
                    aiReply = `تبدأ أسعار منتجاتنا من ${sample.price} ج.م لمجموعات الرتان والأطقم الخارجية. كما نوفر خصماً 10% للكميات التجاري (أكثر من 10 قطع).`;
                } else if (lowerMsg.includes('صنبريلا') || lowerMsg.includes('sunbrella')) {
                    aiReply = `خيار أقمشة Sunbrella العالمية متوفر لجميع الكراسي بقيمة إضافية قدرها ${appState.sunbrellaRatePerChair} ج.م فقط لكل كرسي، للحصول على أعلى درجة مقاومة لأشعة الشمس المباشرة.`;
                } else if (lowerMsg.includes('عنوان') || lowerMsg.includes('مكان') || lowerMsg.includes('مصنع')) {
                    aiReply = `مقر مصنعنا الرئيسي يقع في: ${appState.siteSettings.factoryAddress}. ويمكنك اختيار الاستلام المباشر من المصنع مجاناً!`;
                } else if (lowerMsg.includes('شحن') || lowerMsg.includes('توصيل')) {
                    aiReply = `نوفر خدمات شحن لجميع المحافظات خلال 1 إلى 7 أيام حسَب اختيارك عند تأكيد الطلب.`;
                }

                box.innerHTML += `
                    <div class="bg-neutral-800 p-3 rounded-2xl rounded-tr-none text-gray-200 border border-neutral-700 max-w-[85%]">
                        ${aiReply}
                    </div>
                `;
                box.scrollTop = box.scrollHeight;
            }, 600);
        }

        // Initialize App on Window Load
        window.onload = function() {
            renderAllViews();
            switchView('store');
        };
    </script>
</body>
</html>
