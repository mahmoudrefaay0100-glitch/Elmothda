                <button onclick="filterByDept('all')" class="hover:text-amazon-yellow transition py-1 px-2 rounded hover:ring-1 hover:ring-white">كل المنتجات</button>
                <button onclick="filterByDept('rattan')" class="hover:text-amazon-yellow transition py-1 px-2 rounded hover:ring-1 hover:ring-white">أثاث رتان وحدائق</button>
                <button onclick="filterByDept('living')" class="hover:text-amazon-yellow transition py-1 px-2 rounded hover:ring-1 hover:ring-white">الصالونات وغرف المعيشة</button>
                <button onclick="filterByDept('bedroom')" class="hover:text-amazon-yellow transition py-1 px-2 rounded hover:ring-1 hover:ring-white">غرف النوم الفاخرة</button>
                <button onclick="filterByDept('umbrellas')" class="hover:text-amazon-yellow transition py-1 px-2 rounded hover:ring-1 hover:ring-white">المظلات والشماسي</button>
