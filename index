                        <label class="border border-gray-300 p-3 rounded-lg flex items-center space-x-2 space-x-reverse cursor-pointer bg-gray-50">
                            <input type="radio" name="payment" value="card" class="text-amazon-dark focus:ring-0">
                            <span class="font-bold">بطاقة ائتمان (اونلاين)</span>
                        </label>
                    </div>
                </div>

                <div id="card-section" class="hidden p-4 bg-gray-50 rounded-lg border border-gray-200 space-y-3">
                    <h4 class="font-bold text-xs text-gray-700">محاكاة دفع آمن بالبطاقة</h4>
                    <input type="text" placeholder="رقم البطاقة (16 رقم)" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs">
