<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المتحدة للرتان والأثاث - متجر الأثاث العصري</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        amazonDark: '#131921',
                        amazonLight: '#232f3e',
                        amazonYellow: '#febd69',
                        amazonYellowHover: '#f3a847',
                        amazonOrange: '#ff9900',
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap');
        body { font-family: 'Cairo', sans-serif; background-color: #eaeded; }
    </style>
</head>
<body class="bg-[#eaeded] text-gray-800 min-h-screen flex flex-col">

    <!-- Amazon Header Top Navbar -->
    <header class="bg-amazonDark text-white sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-2 flex items-center justify-between gap-4 flex-wrap">
            <!-- Logo & Location -->
            <div class="flex items-center gap-4">
                <a href="#" onclick="switchTab('home')" class="flex items-center gap-2 border border-transparent hover:border-white p-1 rounded transition">
                    <div id="headerLogoContainer" class="text-xl font-black text-amazonYellow tracking-wider">
                        <span id="brandNameText">المتحدة للرتان</span>
                    </div>
                </a>
                <div class="hidden md:flex items-center gap-1 text-xs text-gray-300 border border-transparent hover:border-white p-1 rounded cursor-pointer">
                    <i class="fa-solid fa-location-dot text-white"></i>
                    <div>
                        <p class="text-[10px] text-gray-400">الشحن أو الاستلام</p>
                        <p class="font-bold text-white">أشمون، المنوفية</p>
                    </div>
                </div>
            </div>

            <!-- Search Bar -->
            <div class="flex-1 max-w-2xl flex items-center min-w-[280px]">
                <div class="bg-gray-100 text-gray-800 px-3 py-2 text-xs rounded-r-none rounded-l-md border-r border-gray-300 font-bold hidden sm:block cursor-pointer hover:bg-gray-200" onclick="toggleDeptDropdown()">
                    <span id="selectedCategorySearchLabel">الكل</span> <i class="fa-solid fa-caret-down mr-1"></i>
                </div>
                <input type="text" id="searchInput" placeholder="ابحث عن أطقم رتان، صالونات، طاولات، ترابيزات..." class="flex-1 px-4 py-2 text-sm text-gray-900 focus:outline-none bg-white">
                <button onclick="handleSearch()" class="bg-amazonYellow hover:bg-amazonYellowHover text-gray-900 px-5 py-2 rounded-l-none rounded-r-md text-base transition">
                    <i class="fa-solid fa-magnifying-glass font-bold"></i>
                </button>
            </div>

            <!-- Account, Orders & Cart -->
            <div class="flex items-center gap-4">
                <button onclick="openAdminModal()" class="border border-transparent hover:border-white p-1 rounded text-xs text-right transition">
                    <span class="block text-gray-400 text-[10px]">لوحة التحكم</span>
                    <span class="font-bold"><i class="fa-solid fa-gear text-amazonYellow ml-1"></i> الإدارة</span>
                </button>
                <button onclick="openCartModal()" class="border border-transparent hover:border-white p-1 rounded flex items-end gap-1 relative transition">
                    <div class="relative">
                        <i class="fa-solid fa-cart-shopping text-2xl text-white"></i>
                        <span id="cartBadge" class="absolute -top-2 -right-2 bg-amazonOrange text-gray-900 text-xs font-black px-1.5 py-0.2 rounded-full">0</span>
                    </div>
                    <span class="font-bold text-sm hidden sm:inline">السلة</span>
                </button>
            </div>
        </div>

        <!-- Sub Navbar (Categories) -->
        <nav class="bg-amazonLight px-4 py-2 text-sm flex items-center gap-6 overflow-x-auto whitespace-nowrap scrollbar-none">
            <button onclick="filterCategory('الكل')" class="hover:text-amazonYellow font-bold flex items-center gap-1 border border-transparent hover:border-white px-2 py-1 rounded">
                <i class="fa-solid fa-bars"></i> الكل
            </button>
            <div id="categoriesNavContainer" class="flex items-center gap-4">
                <!-- Dynamically populated categories -->
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl mx-auto w-full p-4 md:p-6">
        
        <!-- Hero Banner / Carousel Simulation -->
        <div class="bg-gradient-to-r from-amazonDark to-amazonLight text-white rounded-xl p-6 md:p-10 mb-8 shadow-lg flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="max-w-xl">
                <span class="bg-amazonOrange text-gray-900 font-bold text-xs px-3 py-1 rounded-full uppercase tracking-wider">صناعة مصرية فاخرة</span>
                <h1 class="text-3xl md:text-5xl font-black mt-3 mb-3 text-amazonYellow">المتحدة للرتان والأثاث</h1>
                <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6">
                    أحدث وأرقى أطقم الرتان، الحدائق، والترابيزات العصرية المصنوعة بأعلى جودة خامات مع إمكانية التخصيص الكامل لألوان الحديد، الأقمشة، والدوبار حسب طلبك.
                </p>
                <div class="flex items-center gap-4 flex-wrap">
                    <button onclick="scrollToProducts()" class="bg-amazonYellow hover:bg-amazonYellowHover text-gray-900 font-bold px-6 py-3 rounded-md shadow transition">
                        تسوق المنتجات الآن
                    </button>
                    <a href="https://wa.me/201000000000" target="_blank" class="bg-green-600 hover:bg-green-700 text-white font-bold px-6 py-3 rounded-md shadow flex items-center gap-2 transition">
                        <i class="fa-brands fa-whatsapp text-lg"></i> تواصل واتساب
                    </a>
                </div>
            </div>
            <div class="w-full md:w-1/3 bg-white/1{-backdrop-blur p-4 rounded-xl border border-white/20 text-center">
                <i class="fa-solid fa-truck-fast text-5xl text-amazonYellow mb-3"></i>
                <h3 class="font-bold text-lg mb-1">شحن لجميع المحافظات أو الاستلام</h3>
                <p class="text-xs text-gray-300">استلام مباشر من المصنع بأشمون (المنوفية) أو اختر سرعة الشحن لمنزلك بكل فاعلية.</p>
            </div>
        </div>

        <!-- Products Section Header -->
        <div id="productsSection" class="flex items-center justify-between mb-6 flex-wrap gap-4 border-b pb-3">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <i class="fa-solid fa-box-open text-amazonOrange"></i> المعرض والمنتجات المتاحة
            </h2>
            <div class="flex items-center gap-3">
                <span class="text-sm text-gray-600">ترتيب حسب:</span>
                <select id="sortSelect" onchange="renderProducts()" class="bg-white border border-gray-300 text-sm rounded-md px-3 py-1.5 focus:outline-none">
                    <option value="default">الافتراضي</option>
                    <option value="price-low">السعر: من الأقل للأعلى</option>
                    <option value="price-high">السعر: من الأعلى للأقل</option>
                </select>
            </div>
        </div>

        <!-- Products Grid -->
        <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <!-- Dynamically populated products -->
        </div>

    </main>

    <!-- Cart Slide-over / Modal -->
    <div id="cartModal" class="fixed inset-0 bg-black/60 z-50 hidden flex justify-end">
        <div class="bg-white w-full max-w-md h-full flex flex-col shadow-2xl animate-in slide-in-from-left duration-300">
            <div class="bg-amazonDark text-white p-4 flex items-center justify-between">
                <h3 class="font-bold text-lg flex items-center gap-2"><i class="fa-solid fa-cart-shopping text-amazonYellow"></i> سلة التسوق الخاصة بك</h3>
                <button onclick="closeCartModal()" class="text-gray-400 hover:text-white text-xl"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-4 divide-y divide-gray-200">
                <!-- Cart items list -->
            </div>
            <div class="p-4 bg-gray-50 border-t border-gray-200">
                <div class="flex justify-between items-center mb-4">
                    <span class="font-bold text-gray-600">الإجمالي الفرعي:</span>
                    <span id="cartSubtotal" class="font-black text-xl text-amazonOrange">0 ج.م</span>
                </div>
                <button onclick="proceedToCheckout()" class="w-full bg-amazonYellow hover:bg-amazonYellowHover text-gray-900 font-bold py-3 rounded-md shadow transition text-center block">
                    متابعة لإتمام الطلب والدفع
                </button>
            </div>
        </div>
    </div>

    <!-- Checkout Modal with Fulfillment & Tiered Shipping -->
    <div id="checkoutModal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-xl max-w-2xl w-full p-6 shadow-2xl my-8">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-xl font-black text-amazonDark"><i class="fa-solid fa-file-invoice-dollar text-amazonOrange ml-2"></i> إتمام وتأكيد الطلب</h3>
                <button onclick="closeCheckoutModal()" class="text-gray-400 hover:text-gray-600 text-xl"><i class="fa-solid fa-xmark"></i></button>
            </div>
            
            <form id="checkoutForm" onsubmit="submitOrder(event)" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">الاسم الكامل *</label>
                        <input type="text" id="custName" required class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:border-amazonOrange">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">رقم الهاتف / واتساب *</label>
                        <input type="tel" id="custPhone" required class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:border-amazonOrange">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">العنوان التفصيلي (المدينة / المحافظة / الشارع) *</label>
                    <textarea id="custAddress" required rows="2" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:border-amazonOrange"></textarea>
                </div>

                <!-- Fulfillment Method Choice -->
                <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                    <label class="block text-sm font-black text-amazonDark mb-2"><i class="fa-solid fa-truck-ramp-box text-amazonOrange ml-1"></i> طريقة الاستلام والتوصيل *</label>
                    <div class="space-y-2">
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded border border-gray-200 hover:border-amazonOrange">
                            <input type="radio" name="fulfillmentType" value="pickup" checked onchange="toggleFulfillmentOptions()">
                            <div>
                                <p class="font-bold text-sm">استلام مجاني من المصنع (أشمون، المنوفية)</p>
                                <p class="text-xs text-gray-500">بدون أي رسوم شحن - جاهز خلال مدة التصنيع المتفق عليها</p>
                            </div>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer bg-white p-3 rounded border border-gray-200 hover:border-amazonOrange">
                            <input type="radio" name="fulfillmentType" value="delivery" onchange="toggleFulfillmentOptions()">
                            <div>
                                <p class="font-bold text-sm">شحن وتوصيل للمنزل</p>
                                <p class="text-xs text-gray-500">اختر سرعة التوصيل المناسبة لك أدناه</p>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Tiered Shipping Speed (Only if Delivery is selected) -->
                <div id="shippingSpeedContainer" class="hidden bg-blue-50 p-4 rounded-lg border border-blue-200 space-y-3">
                    <label class="block text-sm font-black text-blue-900"><i class="fa-solid fa-stopwatch text-blue-600 ml-1"></i> حدد سرعة التوصيل والمدة المطلوبة:</label>
                    <div class="space-y-2">
                        <label class="flex items-center justify-between p-2.5 bg-white rounded border border-blue-100 cursor-pointer hover:bg-blue-100/50">
                            <div class="flex items-center gap-2">
                                <input type="radio" name="shippingSpeed" value="express" data-cost="500" onchange="updateGrandTotal()">
                                <div>
                                    <p class="font-bold text-sm text-gray-900">شحن سريع جداً (خلال 1 - 2 يوم)</p>
                                    <p class="text-xs text-red-600 font-bold">أولوية قصوى في التجهيز والشحن</p>
                                </div>
                            </div>
                            <span class="font-black text-blue-900">500 ج.م</span>
                        </label>

                        <label class="flex items-center justify-between p-2.5 bg-white rounded border border-blue-100 cursor-pointer hover:bg-blue-100/50">
                            <input type="radio" name="shippingSpeed" value="standard" data-cost="300" checked onchange="updateGrandTotal()">
                            <div class="flex items-center gap-2">
                                <div>
                                    <p class="font-bold text-sm text-gray-900">شحن قياسي (خلال 3 - 5 أيام)</p>
                                    <p class="text-xs text-gray-500">المعدل الطبيعي للتوصيل</p>
                                </div>
                            </div>
                            <span class="font-black text-blue-900">300 ج.م</span>
                        </label>

                        <label class="flex items-center justify-between p-2.5 bg-white rounded border border-blue-100 cursor-pointer hover:bg-blue-100/50">
                            <input type="radio" name="shippingSpeed" value="economy" data-cost="150" onchange="updateGrandTotal()">
                            <div class="flex items-center gap-2">
                                <div>
                                    <p class="font-bold text-sm text-gray-900">شحن اقتصادي مريح (خلال 7 - 10 أيام)</p>
                                    <p class="text-xs text-green-600 font-bold">توفير أعلى في تكلفة الشحن</p>
                                </div>
                            </div>
                            <span class="font-black text-blue-900">150 ج.م</span>
                        </label>
                    </div>
                </div>

                <!-- Grand Total Summary Box -->
                <div class="bg-gray-100 p-4 rounded-lg flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-600">المبلغ الإجمالي النهائي:</p>
                        <p class="text-xs text-gray-500" id="shippingBreakdownText">شامل تكلفة المنتجات ومصاريف الاستلام</p>
                    </div>
                    <span id="grandTotalAmount" class="text-2xl font-black text-amazonOrange">0 ج.م</span>
                </div>

                <div class="flex gap-3 pt-2">
                    <button type="submit" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-3 rounded-md shadow transition flex items-center justify-center gap-2">
                        <i class="fa-brands fa-whatsapp text-xl"></i> إرسال الطلب عبر الواتساب للمصنع
                    </button>
                    <button type="button" onclick="closeCheckoutModal()" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold px-5 py-3 rounded-md transition">
                        إلغاء
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Admin Panel Modal -->
    <div id="adminModal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-xl max-w-4xl w-full p-6 shadow-2xl my-8 max-h-[90vh] flex flex-col">
            <div class="flex justify-between items-center mb-4 border-b pb-3">
                <h3 class="text-xl font-black text-amazonDark"><i class="fa-solid fa-gear text-amazonOrange ml-2"></i> لوحة تحكم المتجر وإدارة المنتجات</h3>
                <button onclick="closeAdminModal()" class="text-gray-400 hover:text-gray-600 text-xl"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div id="adminLoginScreen" class="py-8 max-w-sm mx-auto text-center">
                <div class="bg-amazonDark text-white p-3 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4 text-2xl">
                    <i class="fa-solid fa-lock text-amazonYellow"></i>
                </div>
                <h4 class="font-bold text-lg mb-2">تسجيل دخول الإدارة</h4>
                <p class="text-xs text-gray-500 mb-4">اسم المستخدم: admin | كلمة المرور: 123456</p>
                <input type="password" id="adminPasswordInput" placeholder="أدخل كلمة المرور..." class="w-full border rounded px-3 py-2 mb-3 text-sm text-center">
                <button onclick="verifyAdminLogin()" class="w-full bg-amazonYellow hover:bg-amazonYellowHover font-bold py-2 rounded text-gray-900 transition">دخول لوحة التحكم</button>
            </div>

            <div id="adminDashboardContent" class="hidden flex-1 overflow-y-auto space-y-6">
                <!-- Tabs within admin -->
                <div class="flex gap-2 border-b pb-2">
                    <button onclick="switchAdminTab('products')" id="adminTabProdBtn" class="bg-amazonDark text-white px-4 py-2 rounded text-sm font-bold">إدارة المنتجات</button>
                    <button onclick="switchAdminTab('categories')" id="adminTabCatBtn" class="bg-gray-200 text-gray-700 px-4 py-2 rounded text-sm font-bold">إدارة الأقسام</button>
                    <button onclick="switchAdminTab('settings')" id="adminTabSetBtn" class="bg-gray-200 text-gray-700 px-4 py-2 rounded text-sm font-bold">إعدادات اللوجو</button>
                </div>

                <!-- Tab 1: Products Management -->
                <div id="adminProductsPane" class="space-y-4">
                    <div class="bg-gray-50 p-4 rounded-lg border">
                        <h4 class="font-bold text-sm text-amazonDark mb-3"><i class="fa-solid fa-plus-circle text-amazonOrange ml-1"></i> إضافة منتج جديد للمعرض</h4>
                        <form id="addProductForm" onsubmit="handleAddNewProduct(event)" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                            <input type="text" id="newProdName" placeholder="اسم الطقم أو المنتج *" required class="border rounded px-3 py-2 text-sm bg-white">
                            <input type="number" id="newProdPrice" placeholder="السعر (ج.م) *" required class="border rounded px-3 py-2 text-sm bg-white">
                            <select id="newProdCategory" class="border rounded px-3 py-2 text-sm bg-white">
                                <!-- Populated dynamically -->
                            </select>
                            <input type="text" id="newProdImage" placeholder="رابط صورة المنتج (URL) *" required class="border rounded px-3 py-2 text-sm bg-white">
                            <input type="text" id="newProdDesc" placeholder="وصف قصير للمنتج" class="border rounded px-3 py-2 text-sm bg-white sm:col-span-2">
                            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded text-sm transition">حفظ وإضافة المنتج</button>
                        </form>
                    </div>

                    <div>
                        <h4 class="font-bold text-sm text-gray-700 mb-2">قائمة المنتجات الحالية:</h4>
                        <div id="adminProductListContainer" class="divide-y border rounded bg-white">
                            <!-- Populated dynamically -->
                        </div>
                    </div>
                </div>

                <!-- Tab 2: Categories Management -->
                <div id="adminCategoriesPane" class="hidden space-y-4">
                    <div class="bg-gray-50 p-4 rounded-lg border">
                        <h4 class="font-bold text-sm text-amazonDark mb-3"><i class="fa-solid fa-folder-plus text-amazonOrange ml-1"></i> إضافة قسم جديد</h4>
                        <div class="flex gap-2">
                            <input type="text" id="newCategoryName" placeholder="اسم القسم الجديد (مثلاً: ترابيزات رتان)..." class="flex-1 border rounded px-3 py-2 text-sm bg-white">
                            <button onclick="handleAddNewCategory()" class="bg-amazonYellow hover:bg-amazonYellowHover font-bold px-5 py-2 rounded text-gray-900 text-sm transition">إضافة القسم</button>
                        </div>
                    </div>
                    <div>
                        <h4 class="font-bold text-sm text-gray-700 mb-2">الأقسام الحالية:</h4>
                        <div id="adminCategoryListContainer" class="flex flex-wrap gap-2">
                            <!-- Populated dynamically -->
                        </div>
                    </div>
                </div>

                <!-- Tab 3: Logo Settings -->
                <div id="adminSettingsPane" class="hidden space-y-4">
                    <div class="bg-gray-50 p-4 rounded-lg border max-w-md">
                        <h4 class="font-bold text-sm text-amazonDark mb-3"><i class="fa-solid fa-image text-amazonOrange ml-1"></i> تخصيص اسم أو شعار المتجر</h4>
                        <label class="block text-xs font-bold text-gray-700 mb-1">اسم المتجر في الهيدر:</label>
                        <input type="text" id="settingBrandNameInput" class="w-full border rounded px-3 py-2 text-sm bg-white mb-3" placeholder="المتحدة للرتان">
                        <button onclick="saveBrandSettings()" class="bg-amazonYellow hover:bg-amazonYellowHover font-bold py-2 px-4 rounded text-gray-900 text-sm transition">حفظ التغييرات</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-amazonDark text-white mt-12 py-8 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-right">
            <div>
                <h3 class="text-amazonYellow font-black text-lg mb-3">المتحدة للرتان والأثاث</h3>
                <p class="text-xs text-gray-400 leading-relaxed">
                    متخصصون في صناعة وتوريد أجود أطقم الرتان والحدائق والترابيزات العصرية. جودة عالية وخامات مطابقة للمواصفات.
                </p>
            </div>
            <div>
                <h3 class="font-bold text-sm mb-3 text-white">العنوان والاتصال</h3>
                <p class="text-xs text-gray-400 mb-1"><i class="fa-solid fa-location-dot text-amazonOrange ml-1"></i> محافظة المنوفية - مركز أشمون</p>
                <p class="text-xs text-gray-400 mb-1"><i class="fa-solid fa-phone text-amazonOrange ml-1"></i> 01000000000 / 01200000000</p>
            </div>
            <div>
                <h3 class="font-bold text-sm mb-3 text-white">روابط سريعة</h3>
                <ul class="text-xs text-gray-400 space-y-1">
                    <li><a href="#" onclick="switchTab('home')" class="hover:text-amazonYellow">الرئيسية والمعرض</a></li>
                    <li><a href="#" onclick="openCartModal()" class="hover:text-amazonYellow">سلة التسوق</a></li>
                    <li><a href="#" onclick="openAdminModal()" class="hover:text-amazonYellow">لوحة تحكم الإدارة</a></li>
                </ul>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 mt-8 pt-4 border-t border-gray-800 text-center text-xs text-gray-500">
            جميع الحقوق محفوظة © 2026 المتحدة للرتان والأثاث
        </div>
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        // Initial Default Data
        const defaultCategories = ["أطقم صالونات رتان", "ترابيزات وطاولات", "أطقم حدائق وشاطئ", "كراسي مفردة وبفات"];
        
        const defaultProducts = [
            {
                id: 1,
                name: "طقم رتان ملكي فاخر (أريكة + 2 كرسي + ترابيزة)",
                price: 7500,
                category: "أطقم صالونات رتان",
                image: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=600&q=80",
                desc: "طقم رتان عصري مقاوم للعوامل الجوية مع زجاج سيكوريت سميك."
            },
            {
                id: 2,
                name: "طقم حدائق وشرفات مودرن 4 كراسي مع ترابيزة دائرية",
                price: 5200,
                category: "أطقم حدائق وشاطئ",
                image: "https://images.unsplash.com/photo-1586023492125-27b2c045efd7?auto=format&fit=crop&w=600&q=80",
                desc: "تصميم أنيق ومريح للحدائق والروف والبلكونات الواسعة."
            },
            {
                id: 3,
                name: "ترابيزة رتان مربعة 80x80 سم مع زجاج سميك",
                price: 1800,
                category: "ترابيزات وطاولات",
                image: "https://images.unsplash.com/photo-1533090161767-e6ffed986c88?auto=format&fit=crop&w=600&q=80",
                desc: "ترابيزة عملية متينة بهيكل حديد ومجدولة بعناية فائقة."
            },
            {
                id: 4,
                name: "كرسي مفرد رتان استرخاء مع وسادة تنجيد سميكة",
                price: 1250,
                category: "كراسي مفردة وبفات",
                image: "https://images.unsplash.com/photo-1580481077494-e3299ac2506e?auto=format&fit=crop&w=600&q=80",
                desc: "كرسي مريح للغاية ومقاوم للشمس والرطوبة."
            }
        ];

        // Load from LocalStorage or Fallback
        let categories = JSON.parse(localStorage.getItem('united_categories')) || defaultCategories;
        let products = JSON.parse(localStorage.getItem('united_products')) || defaultProducts;
        let cart = JSON.parse(localStorage.getItem('united_cart')) || [];
        let brandName = localStorage.getItem('united_brand') || "المتحدة للرتان";

        let currentActiveCategory = 'الكل';

        // Init App on Load
        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('brandNameText').innerText = brandName;
            document.getElementById('settingBrandNameInput').value = brandName;
            renderCategoriesNav();
            renderProducts();
            updateCartBadge();
        });

        // Render Categories in Navbar
        function renderCategoriesNav() {
            const navContainer = document.getElementById('categoriesNavContainer');
            const searchDropdownLabel = document.getElementById('selectedCategorySearchLabel');
            const newProdCatSelect = document.getElementById('newProdCategory');
            
            navContainer.innerHTML = '';
            newProdCatSelect.innerHTML = '';

            categories.forEach(cat => {
                navContainer.innerHTML += `<button onclick="filterCategory('${cat}')" class="hover:text-amazonYellow border border-transparent hover:border-white px-2 py-1 rounded transition">${cat}</button>`;
                newProdCatSelect.innerHTML += `<option value="${cat}">${cat}</option>`;
            });

            // Render admin category list
            const adminCatList = document.getElementById('adminCategoryListContainer');
            if(adminCatList) {
                adminCatList.innerHTML = '';
                categories.forEach(cat => {
                    adminCatList.innerHTML += `
                        <div class="bg-gray-100 border px-3 py-1.5 rounded flex items-center gap-2 text-sm">
                            <span>${cat}</span>
                            ${categories.length > 1 ? `<button onclick="deleteCategory('${cat}')" class="text-red-500 hover:text-red-700 font-bold ml-1"><i class="fa-solid fa-trash"></i></button>` : ''}
                        </div>
                    `;
                });
            }
        }

        // Filter Category
        function filterCategory(cat) {
            currentActiveCategory = cat;
            renderProducts();
        }

        // Render Products Grid with Customization Options
        function renderProducts() {
            const grid = document.getElementById('productsGrid');
            const sortVal = document.getElementById('sortSelect').value;
            grid.innerHTML = '';

            let filtered = currentActiveCategory === 'الكل' ? [...products] : products.filter(p => p.category === currentActiveCategory);

            // Search filtering
            const searchQ = document.getElementById('searchInput').value.trim().toLowerCase();
            if(searchQ) {
                filtered = filtered.filter(p => p.name.toLowerCase().includes(searchQ) || p.desc.toLowerCase().includes(searchQ));
            }

            // Sorting
            if(sortVal === 'price-low') filtered.sort((a,b) => a.price - b.price);
            if(sortVal === 'price-high') filtered.sort((a,b) => b.price - a.price);

            if(filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-500 font-bold">لا توجد منتجات مطابقة للبحث أو القسم المحدد.</div>`;
                return;
            }

            filtered.forEach(p => {
                const uniqueId = p.id;
                grid.innerHTML += `
                    <div class="bg-white rounded-lg shadow border border-gray-200 overflow-hidden flex flex-col justify-between hover:shadow-lg transition">
                        <div>
                            <div class="h-48 overflow-hidden bg-gray-100 relative">
                                <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover hover:scale-105 transition duration-300">
                                <span class="absolute top-2 right-2 bg-amazonDark text-white text-[10px] font-bold px-2 py-1 rounded">${p.category}</span>
                            </div>
                            <div class="p-4">
                                <h3 class="font-bold text-gray-900 text-sm mb-1 leading-snug line-clamp-2">${p.name}</h3>
                                <p class="text-xs text-gray-500 mb-3 line-clamp-2">${p.desc}</p>
                                <div class="text-amazonOrange font-black text-lg mb-3">${p.price} <span class="text-xs text-gray-600 font-normal">ج.م</span></div>

                                <!-- CUSTOMIZATION OPTIONS FOR THIS PRODUCT -->
                                <div class="space-y-2 bg-gray-50 p-2.5 rounded border text-xs mb-3">
                                    <p class="font-bold text-amazonDark border-b pb-1 mb-1"><i class="fa-solid fa-sliders text-amazonOrange ml-1"></i> مواصفات الطقم المطلوبة:</p>
                                    
                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="text-[10px] text-gray-600 block mb-0.5">لون الحديد / الهيكل:</label>
                                            <select id="iron_${uniqueId}" class="w-full border rounded p-1 text-[11px] bg-white">
                                                <option value="أسود لامع">أسود لامع</option>
                                                <option value="أسود مطفي">أسود مطفي</option>
                                                <option value="أبيض ناصع">أبيض ناصع</option>
                                                <option value="ذهبي ملكي">ذهبي ملكي</option>
                                                <option value="بني محروق">بني محروق</option>
                                                <option value="رصاصي معدني">رصاصي معدني</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[10px] text-gray-600 block mb-0.5">نوع القماش:</label>
                                            <select id="fabricType_${uniqueId}" class="w-full border rounded p-1 text-[11px] bg-white">
                                                <option value="وتربروف ضد الماء">وتربروف ضد الماء</option>
                                                <option value="جاكوار فاخر">جاكوار فاخر</option>
                                                <option value="قطيفة مستوردة">قطيفة مستوردة</option>
                                                <option value="كتان معالج">كتان معالج</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-2 gap-2">
                                        <div>
                                            <label class="text-[10px] text-gray-600 block mb-0.5">لون التنجيد / القماش:</label>
                                            <input type="text" id="upholsteryColor_${uniqueId}" placeholder="مثال: بيج فاتح / كحلي" class="w-full border rounded p-1 text-[11px] bg-white">
                                        </div>
                                        <div>
                                            <label class="text-[10px] text-gray-600 block mb-0.5">لون الدوبار / الخيوط:</label>
                                            <input type="text" id="dubarColor_${uniqueId}" placeholder="مثال: عسلي / جملي" class="w-full border rounded p-1 text-[11px] bg-white">
                                        </div>
                                    </div>

                                    <div>
                                        <label class="text-[10px] text-gray-600 block mb-0.5">لون الخشب (إن وجد بالأجزاء الخشبية):</label>
                                        <select id="woodColor_${uniqueId}" class="w-full border rounded p-1 text-[11px] bg-white">
                                            <option value="بدون أجزاء خشبية">بدون أجزاء خشبية</option>
                                            <option value="أرو طبيعي">أرو طبيعي</option>
                                            <option value="أستر داكن">أستر داكن</option>
                                            <option value="بني جوزي">بني جوزي</option>
                                            <option value="حرق قديم">حرق قديم</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 pt-0">
                            <button onclick="addToCartWithOptions(${p.id})" class="w-full bg-amazonYellow hover:bg-amazonYellowHover text-gray-900 font-bold py-2 rounded text-xs shadow transition flex items-center justify-center gap-1">
                                <i class="fa-solid fa-cart-plus"></i> أضف للسلة بالمواصفات
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        // Add to Cart with Selected Customizations
        function addToCartWithOptions(id) {
            const product = products.find(p => p.id === id);
            if(!product) return;

            const iron = document.getElementById(`iron_${id}`).value;
            const fabricType = document.getElementById(`fabricType_${id}`).value;
            const upholsteryColor = document.getElementById(`upholsteryColor_${id}`).value || 'حسب الصورة أو القياسي';
            const dubarColor = document.getElementById(`dubarColor_${id}`).value || 'حسب الصورة أو القياسي';
            const woodColor = document.getElementById(`woodColor_${id}`).value;

            const cartItem = {
                cartId: Date.now() + Math.random(),
                productId: product.id,
                name: product.name,
                price: product.price,
                image: product.image,
                customizations: {
                    iron,
                    fabricType,
                    upholsteryColor,
                    dubarColor,
                    woodColor
                },
                quantity: 1
            };

            cart.push(cartItem);
            saveCart();
            updateCartBadge();
            openCartModal();
        }

        function saveCart() {
            localStorage.setItem('united_cart', JSON.stringify(cart));
        }

        function updateCartBadge() {
            const badge = document.getElementById('cartBadge');
            badge.innerText = cart.length;
        }

        // Cart Modal Actions
        function openCartModal() {
            renderCartItems();
            document.getElementById('cartModal').classList.remove('hidden');
        }

        function closeCartModal() {
            document.getElementById('cartModal').classList.add('hidden');
        }

        function renderCartItems() {
            const container = document.getElementById('cartItemsContainer');
            const subtotalEl = document.getElementById('cartSubtotal');
            container.innerHTML = '';

            if(cart.length === 0) {
                container.innerHTML = `<div class="text-center py-12 text-gray-500 font-bold">سلة التسوق فارغة حالياً.</div>`;
                subtotalEl.innerText = '0 ج.م';
                return;
            }

            let subtotal = 0;
            cart.forEach((item, index) => {
                subtotal += item.price * item.quantity;
                container.innerHTML += `
                    py-3 flex gap-3 items-center justify-between">
                        <div class="flex items-center gap-3">
                            <img src="${item.image}" class="w-16 h-16 object-cover rounded border">
                            <div>
                                <h4 class="font-bold text-xs text-gray-900">${item.name}</h4>
                                <p class="text-[11px] text-amazonOrange font-black">${item.price} ج.م</p>
                                <div class="text-[10px] text-gray-500 space-y-0.5 mt-1 bg-gray-50 p-1 rounded">
                                    <p>حديد: ${item.customizations.iron} | قماش: ${item.customizations.fabricType}</p>
                                    <p>تنجيد: ${item.customizations.upholsteryColor} | دوبار: ${item.customizations.dubarColor}</p>
                                    <p>خشب: ${item.customizations.woodColor}</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-2">
                            <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 text-xs"><i class="fa-solid fa-trash"></i></button>
                            <span class="text-xs font-bold">الكمية: ${item.quantity}</span>
                        </div>
                    </div>
                `;
            });

            subtotalEl.innerText = subtotal + ' ج.م';
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            saveCart();
            updateCartBadge();
            renderCartItems();
        }

        // Checkout Modal & Tiered Shipping
        function proceedToCheckout() {
            if(cart.length === 0) {
                alert('سلة التسوق فارغة!');
                return;
            }
            closeCartModal();
            updateGrandTotal();
            document.getElementById('checkoutModal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal').classList.add('hidden');
        }

        function toggleFulfillmentOptions() {
            const fulfillment = document.querySelector('input[name="fulfillmentType"]:checked').value;
            const speedContainer = document.getElementById('shippingSpeedContainer');
            if(fulfillment === 'delivery') {
                speedContainer.classList.remove('hidden');
            } else {
                speedContainer.classList.add('hidden');
            }
            updateGrandTotal();
        }

        function updateGrandTotal() {
            let subtotal = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
            const fulfillment = document.querySelector('input[name="fulfillmentType"]:checked').value;
            
            let shippingCost = 0;
            let breakdownText = 'استلام مجاني من المصنع بأشمون، المنوفية';

            if(fulfillment === 'delivery') {
                const selectedSpeed = document.querySelector('input[name="shippingSpeed"]:checked');
                if(selectedSpeed) {
                    shippingCost = parseInt(selectedSpeed.getAttribute('data-cost'));
                    if(selectedSpeed.value === 'express') breakdownText = 'شحن سريع جداً (1-2 يوم)';
                    else if(selectedSpeed.value === 'standard') breakdownText = 'شحن قياسي (3-5 أيام)';
                    else if(selectedSpeed.value === 'economy') breakdownText = 'شحن اقتصادي مريح (7-10 أيام)';
                }
            }

            const grandTotal = subtotal + shippingCost;
            document.getElementById('shippingBreakdownText').innerText = `${breakdownText} (${shippingCost} ج.م شحن)`;
            document.getElementById('grandTotalAmount').innerText = grandTotal + ' ج.م';
        }

        function submitOrder(e) {
            e.preventDefault();
            const name = document.getElementById('custName').value;
            const phone = document.getElementById('custPhone').value;
            const address = document.getElementById('custAddress').value;
            const fulfillment = document.querySelector('input[name="fulfillmentType"]:checked').value;
            
            let shippingDetails = 'استلام من المصنع (أشمون - المنوفية)';
            let shippingCost = 0;
            if(fulfillment === 'delivery') {
                const speed = document.querySelector('input[name="shippingSpeed"]:checked').value;
                if(speed === 'express') { shippingDetails = 'شحن سريع (1-2 يوم)'; shippingCost = 500; }
                else if(speed === 'standard') { shippingDetails = 'شحن قياسي (3-5 أيام)'; shippingCost = 300; }
                else if(speed === 'economy') { shippingDetails = 'شحن اقتصادي (7-10 أيام)'; shippingCost = 150; }
            }

            let subtotal = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
            let total = subtotal + shippingCost;

            let itemsText = '';
            cart.forEach((item, idx) => {
                itemsText += `\n${idx+1}. *${item.name}*\n   - السعر: ${item.price} ج.م\n   - الحديد: ${item.customizations.iron}\n   - القماش: ${item.customizations.fabricType} (${item.customizations.upholsteryColor})\n   - الدوبار: ${item.customizations.dubarColor}\n   - الخشب: ${item.customizations.woodColor}\n`;
            });

            const whatsappMessage = `*طلب جديد عبر متجر المتحدة للرتان* 🛋️\n\n` +
                `*بيانات العميل:*\n` +
                `- الاسم: ${name}\n` +
                `- الهاتف: ${phone}\n` +
                `- العنوان: ${address}\n` +
                `- طريقة الاستلام والشحن: ${shippingDetails}\n\n` +
                `*المنتجات المطلوبة:*${itemsText}\n` +
                `-------------------\n` +
                `- إجمالي المنتجات: ${subtotal} ج.م\n` +
                `- تكلفة الشحن: ${shippingCost} ج.م\n` +
                `- *الإجمالي الكلي النهائي: ${total} ج.م*`;

            const whatsappUrl = `https://wa.me/201000000000?text=${encodeURIComponent(whatsappMessage)}`;
            window.open(whatsappUrl, '_blank');

            // Clear cart after order
            cart = [];
            saveCart();
            updateCartBadge();
            closeCheckoutModal();
            alert('تم إرسال طلبك بنجاح وتحويلك للواتساب لتأكيد التفاصيل مع المصنع!');
        }

        // Admin Panel Functions
        function openAdminModal() {
            document.getElementById('adminModal').classList.remove('hidden');
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
        }

        function verifyAdminLogin() {
            const pass = document.getElementById('adminPasswordInput').value;
            if(pass === '123456') {
                document.getElementById('adminLoginScreen').classList.add('hidden');
                document.getElementById('adminDashboardContent').classList.remove('hidden');
                renderAdminProductList();
                renderCategoriesNav();
            } else {
                alert('كلمة المرور غير صحيحة! (كلمة المرور الافتراضية: 123456)');
            }
        }

        function switchAdminTab(tab) {
            document.getElementById('adminProductsPane').classList.add('hidden');
            document.getElementById('adminCategoriesPane').classList.add('hidden');
            document.getElementById('adminSettingsPane').classList.add('hidden');
            
            document.getElementById('adminTabProdBtn').className = "bg-gray-200 text-gray-700 px-4 py-2 rounded text-sm font-bold";
            document.getElementById('adminTabCatBtn').className = "bg-gray-200 text-gray-700 px-4 py-2 rounded text-sm font-bold";
            document.getElementById('adminTabSetBtn').className = "bg-gray-200 text-gray-700 px-4 py-2 rounded text-sm font-bold";

            if(tab === 'products') {
                document.getElementById('adminProductsPane').classList.remove('hidden');
                document.getElementById('adminTabProdBtn').className = "bg-amazonDark text-white px-4 py-2 rounded text-sm font-bold";
                renderAdminProductList();
            } else if(tab === 'categories') {
                document.getElementById('adminCategoriesPane').classList.remove('hidden');
                document.getElementById('adminTabCatBtn').className = "bg-amazonDark text-white px-4 py-2 rounded text-sm font-bold";
                renderCategoriesNav();
            } else if(tab === 'settings') {
                document.getElementById('adminSettingsPane').classList.remove('hidden');
                document.getElementById('adminTabSetBtn').className = "bg-amazonDark text-white px-4 py-2 rounded text-sm font-bold";
            }
        }

        function handleAddNewProduct(e) {
            e.preventDefault();
            const name = document.getElementById('newProdName').value;
            const price = parseFloat(document.getElementById('newProdPrice').value);
            const category = document.getElementById('newProdCategory').value;
            const image = document.getElementById('newProdImage').value;
            const desc = document.getElementById('newProdDesc').value;

            const newProduct = {
                id: Date.now(),
                name,
                price,
                category,
                image,
                desc
            };

            products.push(newProduct);
            localStorage.setItem('united_products', JSON.stringify(products));
            renderProducts();
            renderAdminProductList();
            document.getElementById('addProductForm').reset();
            alert('تم إضافة المنتج بنجاح!');
        }

        function renderAdminProductList() {
            const container = document.getElementById('adminProductListContainer');
            container.innerHTML = '';
            products.forEach(p => {
                container.innerHTML += `
                    <div class="p-3 flex items-center justify-between gap-3 text-sm">
                        <div class="flex items-center gap-3">
                            <img src="${p.image}" class="w-12 h-12 object-cover rounded">
                            <div>
                                <p class="font-bold text-gray-900">${p.name}</p>
                                <p class="text-xs text-amazonOrange font-black">${p.price} ج.م | <span class="text-gray-500">${p.category}</span></p>
                            </div>
                        </div>
                        <button onclick="deleteProduct(${p.id})" class="text-red-500 hover:text-red-700 font-bold p-2"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            });
        }

        function deleteProduct(id) {
            if(confirm('هل أنت متأكد من حذف هذا المنتج؟')) {
                products = products.filter(p => p.id !== id);
                localStorage.setItem('united_products', JSON.stringify(products));
                renderProducts();
                renderAdminProductList();
            }
        }

        function handleAddNewCategory() {
            const catName = document.getElementById('newCategoryName').value.trim();
            if(!catName) return;
            if(categories.includes(catName)) {
                alert('هذا القسم موجود بالفعل!');
                return;
            }
            categories.push(catName);
            localStorage.setItem('united_categories', JSON.stringify(categories));
            renderCategoriesNav();
            document.getElementById('newCategoryName').value = '';
            alert('تم إضافة القسم بنجاح!');
        }

        function deleteCategory(cat) {
            if(confirm(`هل تريد حذف القسم "${cat}"؟`)) {
                categories = categories.filter(c => c !== cat);
                localStorage.setItem('united_categories', JSON.stringify(categories));
                renderCategoriesNav();
            }
        }

        function saveBrandSettings() {
            const newName = document.getElementById('settingBrandNameInput').value.trim();
            if(!newName) return;
            brandName = newName;
            localStorage.setItem('united_brand', brandName);
            document.getElementById('brandNameText').innerText = brandName;
            alert('تم تحديث اسم المتجر بنجاح!');
        }

        function handleSearch() {
            renderProducts();
        }

        function scrollToProducts() {
            document.getElementById('productsSection').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>
