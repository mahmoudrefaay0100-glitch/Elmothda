            if (searchQuery) {
                filtered = filtered.filter(p => p.name.toLowerCase().includes(searchQuery) || p.description.toLowerCase().includes(searchQuery));
            }

            document.getElementById('product-count-badge').textContent = `عرض ${filtered.length} منتج`;

