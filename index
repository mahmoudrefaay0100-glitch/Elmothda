                            <!-- Populated by JavaScript -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: TODAY'S DEALS -->
        <section id="tab-deals" class="tab-content hidden max-w-7xl mx-auto px-4 sm:px-6 py-8">
            <div class="bg-amber-50 border-2 border-amazon-yellow p-6 sm:p-8 rounded-2xl mb-8 flex items-center justify-between">
                <div>
                    <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest inline-block mb-3">عروض حصرية لفترة محدودة</span>
                    <h2 class="text-2xl sm:text-3xl font-black text-amazon-dark">تخفيضات اليوم الكبرى (Today's Deals)</h2>
                    <p class="text-gray-600 text-xs sm:text-sm mt-1">وفر حتى 30% على تشكيلات طقم الحدائق وغرف المعيشة المصنوعة في مصنعنا بأشمون.</p>
                </div>
                <div class="hidden sm:block text-4xl text-amazon-yellow font-black">
                    <i class="fa-solid fa-tags"></i>
                </div>
            </div>
            <div id="deals-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Populated by JavaScript -->
            </div>
        </section>

    </main>

    <!-- CART MODAL -->
    <div id="cart-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div class="bg-amazon-dark text-white p-4 flex justify-between items-center">
                <h3 class="text-lg font-bold flex items-center">
                    <i class="fa-solid fa-cart-shopping ml-2 text-amazon-yellow"></i>
                    سلة المشتريات
                </h3>
                <button onclick="closeCartModal()" class="text-gray-300 hover:text-white text-xl p-1"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div id="cart-items-container" class="flex-grow overflow-y-auto p-6 space-y-4">
                <!-- Cart items populated by JS -->
            </div>
            <div class="bg-gray-100 p-6 border-t border-gray-200 space-y-4">
                <div class="flex justify-between items-center text-lg font-black">
                    <span>الإجمالي الكلي:</span>
                    <span id="cart-total-price" class="text-amazon-link text-xl">0 ج.م</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button onclick="openCheckoutModal()" class="amazon-btn font-bold text-amazon-dark py-3.5 text-sm shadow flex items-center justify-center">
                        <i class="fa-solid fa-bag-shopping ml-2"></i>
                        <span>إتمام الطلب (الدفع والتوصيل)</span>
                    </button>
                    <button onclick="checkoutWhatsApp()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-lg text-sm shadow flex items-center justify-center transition">
                        <i class="fa-brands fa-whatsapp text-lg ml-2"></i>
                        <span>إرسال الطلب عبر واتساب</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- CHECKOUT & ADDRESS MODAL -->
    <div id="checkout-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-xl rounded-2xl shadow-2xl overflow-hidden max-h-[90vh] flex flex-col">
            <div class="bg-amazon-dark text-white p-4 flex justify-between items-center">
                <h3 class="text-lg font-bold">بيانات الشحن وتأكيد الطلب</h3>
                <button onclick="closeCheckoutModal()" class="text-gray-300 hover:text-white text-xl"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form onsubmit="processOrder(event)" class="p-6 space-y-4 overflow-y-auto flex-grow text-xs sm:text-sm">
                <div>
                    <label class="block font-bold text-gray-700 mb-1">الاسم الكريم</label>
                    <input type="text" id="chk-name" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amazon-yellow">
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">رقم الهاتف الأساسي (للتواصل)</label>
                    <input type="tel" id="chk-phone" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amazon-yellow" placeholder="010xxxxxxxx">
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">المحافظة</label>
                    <select id="chk-gov" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amazon-yellow">
                        <option value="المنوفية">المنوفية (أشمون - مقر المصنع)</option>
                        <option value="القاهرة">القاهرة</option>
                        <option value="الجيزة">الجيزة</option>
                        <option value="الإسكندرية">الإسكندرية</option>
                        <option value="القليوبية">القليوبية</option>
                        <option value="الغربية">الغربية</option>
                        <option value="الشرقية">الشرقية</option>
                        <option value="محافظة أخرى">محافظة أخرى</option>
                    </select>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-1">العنوان التفصيلي (المدينة، الشارع، علامة مميزة)</label>
                    <textarea id="chk-address" rows="2" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amazon-yellow" placeholder="أدخل العنوان بالتفصيل لضمان سرعة التوصيل..."></textarea>
                </div>
                <div>
                    <label class="block font-bold text-gray-700 mb-2">طريقة الدفع</label>
