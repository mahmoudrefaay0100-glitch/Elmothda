            <!-- Search Bar with Dropdown -->
            <div class="flex-grow max-w-2xl flex items-center">
                <div class="flex w-full rounded-md overflow-hidden focus-within:ring-2 focus-within:ring-amazon-yellow">
                    <select id="search-category-select" class="hidden sm:block bg-gray-100 text-gray-800 text-xs px-3 py-2.5 border-r border-gray-300 focus:outline-none cursor-pointer">
