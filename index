        function sortProducts(type) {
            if (type === 'low-high') {
                products.sort((a, b) => a.price - b.price);
            } else if (type === 'high-low') {
                products.sort((a, b) => b.price - a.price);
            }
            renderProductsGrid();
        }

        // Star Rating Generator Helper
        function renderStars(rating) {
            let html = '';
            for (let i = 1; i <= 5; i++) {
                if (i <= Math.floor(rating)) {
                    html += '<i class="fa-solid fa-star"></i>';
                } else if (i - rating < 1 && i - rating > 0) {
                    html += '<i class="fa-solid fa-star-half-stroke"></i>';
                } else {
                    html += '<i class="fa-regular fa-star"></i>';
                }
            }
            return html;
        }

        // Product Detail & Customer Reviews Modal
        function openProductDetail(id) {
            const p = products.find(item => item.id === id);
            if (!p) return;

            document.getElementById('modal-prod-title').textContent = p.name;
            const content = document.getElementById('modal-prod-content');
            content.innerHTML = `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="h-72 rounded-xl overflow-hidden bg-gray-100 border">
                        <img src="${p.image}" alt="" class="w-full h-full object-cover">
                    </div>
                    <div class="space-y-4">
                        <span class="bg-gray-100 text-gray-800 text-xs font-bold px-3 py-1 rounded">القسم: ${p.category}</span>
                        <h4 class="text-xl font-black text-amazon-text">${p.name}</h4>
                        <div class="flex items-center space-x-1 space-x-reverse text-amber-500 text-sm">
                            ${renderStars(p.rating || 4.8)}
                            <span class="text-gray-600 text-xs mr-2">(${p.reviewsCount || 100} تقييم عميل)</span>
                        </div>
                        <div class="text-2xl font-black text-amazon-text">
                            ${p.price.toLocaleString()} <span class="text-sm font-normal">ج.م</span>
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">${p.description}</p>
                        <button onclick="addToCart(${p.id}); closeProductDetailModal();" class="w-full amazon-btn py-3 font-bold text-amazon-dark shadow">
                            <i class="fa-solid fa-cart-plus ml-1"></i> إضافة إلى السلة
                        </button>
                    </div>
                </div>
                <div class="border-t pt-6 mt-6 space-y-4">
                    <h5 class="font-bold text-sm text-amazon-text">آراء وتقييمات العملاء السابقين</h5>
                    <div class="space-y-3 text-xs">
                        <div class="bg-gray-50 p-3 rounded-lg border">
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-gray-800">أحمد محمد (القاهرة)</span>
                                <span class="text-amber-500"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span>
                            </div>
                            <p class="text-gray-600">الخامات ممتازة جداً ومطابقة للصور، والتوصيل كان في الميعاد المحدد. شكراً لمصنع المتحدة بأشمون.</p>
                        </div>
                        <div class="bg-gray-50 p-3 rounded-lg border">
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-bold text-gray-800">محمود إبراهيم (المنوفية)</span>
                                <span class="text-amber-500"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></span>
                            </div>
                            <p class="text-gray-600">متانة عالية وتصميم راقي جداً يضيف فخامة للحديقة. أنصح بالتعامل معهم بشدة.</p>
                        </div>
                    </div>
                </div>
            `;
            document.getElementById('product-detail-modal').classList.remove('hidden');
        }

        function closeProductDetailModal() {
            document.getElementById('product-detail-modal').classList.add('hidden');
        }

        // Cart Management
        function addToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;
            const existing = cart.find(i => i.id === productId);
            if (existing) {
                existing.qty += 1;
            } else {
                cart.push({ ...product, qty: 1 });
            }
            saveCart();
            updateCartBadge();
            showNotification('تمت الإضافة للسلة', `تم إضافة "${product.name}" بنجاح.`);
        }

        function removeFromCart(productId) {
            cart = cart.filter(i => i.id !== productId);
            saveCart();
            updateCartBadge();
            renderCartModal();
        }

        function updateCartQty(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) {
                    removeFromCart(productId);
                } else {
                    saveCart();
                    updateCartBadge();
                    renderCartModal();
                }
            }
        }

        function saveCart() {
            localStorage.setItem('um_amazon_cart', JSON.stringify(cart));
        }

        function updateCartBadge() {
            const badge = document.getElementById('cart-badge');
            if (badge) {
                const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
                badge.textContent = totalQty;
            }
        }

        function openCartModal() {
            renderCartModal();
            document.getElementById('cart-modal').classList.remove('hidden');
        }

        function closeCartModal() {
            document.getElementById('cart-modal').classList.add('hidden');
        }

        function renderCartModal() {
            const container = document.getElementById('cart-items-container');
            const totalEl = document.getElementById('cart-total-price');
            if (!container) return;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-gray-500 text-xs">
                        <i class="fa-solid fa-cart-shopping text-4xl mb-3 text-gray-300"></i>
                        <p>سلة المشتريات فارغة حالياً.</p>
                    </div>
                `;
                if (totalEl) totalEl.textContent = '0 ج.م';
                return;
            }

            let total = 0;
            container.innerHTML = cart.map(item => {
                const itemTotal = item.price * item.qty;
                total += itemTotal;
                return `
                    <div class="flex items-center justify-between bg-gray-50 p-3 rounded-xl border gap-4">
                        <img src="${item.image}" alt="" class="w-14 h-14 object-cover rounded-lg border">
                        <div class="flex-grow">
                            <h4 class="font-bold text-xs text-amazon-text">${item.name}</h4>
                            <span class="text-[10px] text-gray-500">${item.price.toLocaleString()} ج.م للقطعة</span>
                        </div>
                        <div class="flex items-center space-x-1 space-x-reverse">
                            <button onclick="updateCartQty(${item.id}, -1)" class="w-6 h-6 bg-white border rounded font-bold text-xs">-</button>
                            <span class="text-xs font-bold px-2">${item.qty}</span>
                            <button onclick="updateCartQty(${item.id}, 1)" class="w-6 h-6 bg-white border rounded font-bold text-xs">+</button>
                        </div>
                        <div class="text-xs font-bold text-amazon-text w-20 text-left">${itemTotal.toLocaleString()} ج.م</div>
                        <button onclick="removeFromCart(${item.id})" class="text-red-500 hover:text-red-700 p-1"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            }).join('');

            if (totalEl) totalEl.textContent = total.toLocaleString() + ' ج.م';
        }

        function openCheckoutModal() {
            if (cart.length === 0) {
                showNotification('السلة فارغة', 'يرجى إضافة منتجات أولاً.', 'exclamation');
                return;
            }
            closeCartModal();
            document.getElementById('checkout-modal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkout-modal').classList.add('hidden');
        }

        function processOrder(e) {
            e.preventDefault();
            const name = document.getElementById('chk-name').value;
            const phone = document.getElementById('chk-phone').value;
            const gov = document.getElementById('chk-gov').value;
            const address = document.getElementById('chk-address').value;
            const payment = document.querySelector('input[name="payment"]:checked').value;

            const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const newOrder = {
                id: 'AMZ-' + Math.floor(100000 + Math.random() * 900000),
                date: new Date().toLocaleString('ar-EG'),
                customer: { name, phone, gov, address },
                items: [...cart],
                total: total,
                payment: payment === 'card' ? 'بطاقة ائتمان اونلاين' : 'الدفع عند الاستلام',
                status: 'قيد التجهيز والشحن'
            };

            orders.push(newOrder);
            localStorage.setItem('um_amazon_orders', JSON.stringify(orders));

            cart = [];
            saveCart();
            updateCartBadge();
            closeCheckoutModal();

            showNotification('تم استلام طلبك بنجاح!', `رقم الطلب الخاص بك: ${newOrder.id}. سنتواصل معك قريباً للتوصيل.`);
        }

        function checkoutWhatsApp() {
            if (cart.length === 0) {
                showNotification('السلة فارغة', 'يرجى إضافة منتجات أولاً.', 'exclamation');
                return;
            }
            let text = "السلام عليكم، أرغب في طلب المنتجات التالية من متجر المتحدة للرتان والأثاث:\n\n";
            let total = 0;
            cart.forEach((i, idx) => {
                text += `${idx + 1}. ${i.name} (عدد: ${i.qty}) - السعر: ${i.price * i.qty} ج.م\n`;
                total += i.price * i.qty;
            });
            text += `\n*الإجمالي الكلي: ${total.toLocaleString()} ج.م*\n\nيرجى تأكيد التوصيل.`;
            window.open(`https://wa.me/201000000000?text=${encodeURIComponent(text)}`, '_blank');
        }

        // Order Tracker Modal
        function openTrackerModal() {
            const container = document.getElementById('tracker-orders-list');
            if (orders.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-gray-500 text-xs">لا توجد طلبات سابقة مسجلة في هذا المتصفح.</div>`;
            } else {
                container.innerHTML = orders.map(ord => `
                    <div class="bg-gray-50 p-4 rounded-xl border space-y-2 text-xs">
                        <div class="flex justify-between font-bold border-b pb-2">
                            <span class="text-amazon-link">${ord.id}</span>
                            <span class="text-emerald-600">${ord.status}</span>
                        </div>
                        <p><strong>العميل:</strong> ${ord.customer.name} - ${ord.customer.phone}</p>
                        <p><strong>العنوان:</strong> ${ord.customer.gov} - ${ord.customer.address}</p>
                        <p><strong>الإجمالي:</strong> ${ord.total.toLocaleString()} ج.م (${ord.payment})</p>
                        <div class="text-[10px] text-gray-500 pt-1">تاريخ الطلب: ${ord.date}</div>
                    </div>
                `).join('');
            }
            document.getElementById('tracker-modal').classList.remove('hidden');
        }

        function closeTrackerModal() {
            document.getElementById('tracker-modal').classList.add('hidden');
        }

        // Admin Panel & Authentication
        function openAdminLoginModal() {
            document.getElementById('admin-login-modal').classList.remove('hidden');
        }

        function closeAdminLoginModal() {
            document.getElementById('admin-login-modal').classList.add('hidden');
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const u = document.getElementById('admin-user').value;
            const p = document.getElementById('admin-pass').value;
            if (u === 'admin' && p === '123456') {
                closeAdminLoginModal();
                openAdminPanel();
            } else {
                showNotification('خطأ في البيانات', 'اسم المستخدم أو كلمة المرور غير صحيحة.', 'exclamation');
            }
        }

        function openAdminPanel() {
            document.getElementById('admin-panel-modal').classList.remove('hidden');
            renderAdminProducts();
            renderAdminOrders();
        }

        function closeAdminPanel() {
            document.getElementById('admin-panel-modal').classList.add('hidden');
        }

        function switchAdminTab(tab) {
            if (tab === 'products') {
                document.getElementById('adm-tab-products').classList.remove('hidden');
                document.getElementById('adm-tab-orders').classList.add('hidden');
                document.getElementById('adm-btn-prod').className = "px-5 py-2 rounded-lg font-bold text-xs bg-amazon-yellow text-amazon-dark shadow";
                document.getElementById('adm-btn-ord').className = "px-5 py-2 rounded-lg font-bold text-xs bg-white text-gray-700 border";
            } else {
                document.getElementById('adm-tab-products').classList.add('hidden');
                document.getElementById('adm-tab-orders').classList.remove('hidden');
                document.getElementById('adm-btn-ord').className = "px-5 py-2 rounded-lg font-bold text-xs bg-amazon-yellow text-amazon-dark shadow";
                document.getElementById('adm-btn-prod').className = "px-5 py-2 rounded-lg font-bold text-xs bg-white text-gray-700 border";
            }
        }

        function renderAdminProducts() {
            const tbody = document.getElementById('admin-products-tbody');
            if (!tbody) return;
            tbody.innerHTML = products.map(p => `
                <tr class="hover:bg-gray-50 border-b">
                    <td class="p-2"><img src="${p.image}" class="w-10 h-10 object-cover rounded border"></td>
                    <td class="p-2 font-bold text-amazon-text">${p.name}</td>
                    <td class="p-2 text-gray-600">${p.category}</td>
                    <td class="p-2 font-bold text-amazon-link">${p.price.toLocaleString()} ج.م</td>
                    <td class="p-2 text-center space-x-1 space-x-reverse">
                        <button onclick="editProduct(${p.id})" class="p-1.5 bg-gray-100 rounded text-blue-600" title="تعديل"><i class="fa-solid fa-pen"></i></button>
                        <button onclick="deleteProduct(${p.id})" class="p-1.5 bg-gray-100 rounded text-red-600" title="حذف"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function openAddProductModal() {
            document.getElementById('prod-form-title').textContent = "إضافة منتج جديد";
            document.getElementById('edit-prod-id').value = "";
            document.getElementById('p-name').value = "";
            document.getElementById('p-price').value = "";
            document.getElementById('p-dept').value = "rattan";
            document.getElementById('p-img').value = "";
            document.getElementById('p-desc').value = "";
            document.getElementById('product-form-modal').classList.remove('hidden');
        }

        function editProduct(id) {
            const p = products.find(i => i.id === id);
            if (!p) return;
            document.getElementById('prod-form-title').textContent = "تعديل المنتج";
            document.getElementById('edit-prod-id').value = p.id;
            document.getElementById('p-name').value = p.name;
            document.getElementById('p-price').value = p.price;
            document.getElementById('p-dept').value = p.category;
            document.getElementById('p-img').value = p.image;
            document.getElementById('p-desc').value = p.description;
            document.getElementById('product-form-modal').classList.remove('hidden');
        }

        function closeProductFormModal() {
            document.getElementById('product-form-modal').classList.add('hidden');
        }

        function saveProductData(e) {
            e.preventDefault();
            const editId = document.getElementById('edit-prod-id').value;
            const name = document.getElementById('p-name').value;
            const price = parseFloat(document.getElementById('p-price').value);
            const category = document.getElementById('p-dept').value;
            const image = document.getElementById('p-img').value;
            const description = document.getElementById('p-desc').value;

            if (editId) {
                const p = products.find(i => i.id == editId);
                if (p) {
                    p.name = name;
                    p.price = price;
                    p.category = category;
                    p.image = image;
                    p.description = description;
                }
            } else {
                const newId = products.length > 0 ? Math.max(...products.map(i => i.id)) + 1 : 1;
                products.push({ id: newId, name, price, category, image, description, rating: 5.0, reviewsCount: 1 });
            }

            localStorage.setItem('um_amazon_products', JSON.stringify(products));
            closeProductFormModal();
            renderAdminProducts();
            renderProductsGrid();
            renderDealsGrid();
            showNotification('تم الحفظ', 'تم حفظ بيانات المنتج بنجاح.');
        }

        function deleteProduct(id) {
            products = products.filter(i => i.id !== id);
            localStorage.setItem('um_amazon_products', JSON.stringify(products));
            renderAdminProducts();
            renderProductsGrid();
            renderDealsGrid();
            showNotification('تم الحذف', 'تم حذف المنتج بنجاح.');
        }

        function renderAdminOrders() {
            const container = document.getElementById('admin-orders-container');
            const countEl = document.getElementById('adm-orders-count');
            if (!container) return;
            if (countEl) countEl.textContent = orders.length;

            if (orders.length === 0) {
                container.innerHTML = `<div class="text-center py-12 text-gray-500 text-xs">لا توجد طلبات واردة حتى الآن.</div>`;
                return;
            }

            container.innerHTML = orders.map(ord => `
                <div class="bg-gray-50 p-4 rounded-xl border space-y-2 text-xs">
                    <div class="flex justify-between font-bold border-b pb-2">
                        <span class="text-amazon-link">${ord.id} (${ord.date})</span>
                        <span class="text-emerald-600">${ord.status}</span>
                    </div>
                    <p><strong>العميل:</strong> ${ord.customer.name} - ${ord.customer.phone}</p>
                    <p><strong>العنوان:</strong> ${ord.customer.gov} - ${ord.customer.address}</p>
                    <p><strong>الإجمالي:</strong> ${ord.total.toLocaleString()} ج.م | <strong>الدفع:</strong> ${ord.payment}</p>
                </div>
            `).join('');
        }

        // Custom Notification Box
        function showNotification(title, msg, type = 'check') {
            const modal = document.getElementById('notification-modal');
            document.getElementById('notif-title').textContent = title;
            document.getElementById('notif-msg').textContent = msg;
            const icon = document.getElementById('notif-icon');
            if (type === 'exclamation') {
                icon.innerHTML = '<i class="fa-solid fa-exclamation"></i>';
            } else {
                icon.innerHTML = '<i class="fa-solid fa-check"></i>';
            }
            modal.classList.remove('hidden');
        }

        function closeNotification() {
            document.getElementById('notification-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
